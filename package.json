{
  "name": "jarvis-backend",
  "version": "1.0.0",
  "description": "JARVIS AI OS — chat with multi-provider LLM fallback (Gemini/Groq/OpenRouter/Grok), weather (Open-Meteo), voice (ElevenLabs), live terminal, and the HUD frontend, all served from this one app. Also ships as a Windows desktop app via Electron.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pretest": "node scripts/check-deps.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.104.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "screenshot-desktop": "^1.15.4",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.33.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.7"
  },
  "build": {
    "appId": "com.namo.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "routes/**/*",
      "utils/**/*",
      "middleware/**/*",
      "schemas/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      },
      {
        "from": "supabase-schema.sql",
        "to": "supabase-schema.sql"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
