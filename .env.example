# Copy this file to ".env" and fill in your real values.
# NEVER commit .env or paste your real keys into chat — .gitignore already excludes it.

# ---- Chat / LLM providers (/api/chat) ----
# JARVIS tries these in the order listed in LLM_PROVIDER_ORDER below, and falls
# back to the next one automatically if a provider errors out or hits a rate
# limit. You only NEED one key filled in — Gemini is the recommended primary
# since it has the most generous permanent free tier. Fill in more for real
# fallback coverage (this is the whole point of this feature).

# Primary — aistudio.google.com/apikey. Genuinely free tier, no card needed
# (Gemini 2.5 Flash: ~15 requests/min, 1,500/day as of writing).
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Fallback #1 — console.groq.com/keys. Free tier, extremely fast inference,
# open-weight models only (no GPT/Gemini/Claude on Groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback #2 — openrouter.ai/keys. Free tier (200 req/day, 1,000 with a one-time
# $10 top-up). The free-model lineup rotates — if OPENROUTER_MODEL stops working,
# check openrouter.ai/models for a current ":free" model ID and swap it in here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Fallback #3, optional — console.x.ai. No free tier (small credit top-up
# required), kept last in the order for that reason.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional — platform.openai.com/api-keys. Lets you route to ChatGPT/GPT models
# specifically (pass provider:"openai" in a /api/chat request), or use it as
# just another fallback in the chain.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — perplexity.ai/settings/api. Perplexity's "sonar" models search the
# live web as part of the answer, so this doubles as another search-grounded
# fallback alongside Exa/Tavily below.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Order to try providers in (comma-separated). Only providers with a key set
# above are actually used — leaving a key blank just skips that entry.
LLM_PROVIDER_ORDER=gemini,groq,openrouter,xai,openai,perplexity

# ---- Semantic memory (Phase 3) ----
# Long-term memory (utils/longTermMemory.js) embeds entries for semantic
# search using GEMINI_API_KEY or OPENAI_API_KEY above — no separate key
# needed. Leave both unset and it transparently falls back to the original
# keyword-overlap search; nothing else changes. Override the embedding model
# only if the defaults below stop working:
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Weather (Open-Meteo) needs NO API key — nothing to fill in here.

# Required — powers the /api/voice endpoint (Jarvis's spoken voice)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Optional — real-time web search for /api/chat. This is what actually gives
# JARVIS current information — none of the chat providers above browse the web
# on their own through these basic endpoints.
# Get a key at exa.ai (free tier: 1,000 searches/month). Leave blank to skip.
EXA_API_KEY=

# Optional — same idea as Exa, a second search source for /api/chat. Get a key at
# tavily.com (free tier: 1,000 searches/month). Leave blank to skip.
TAVILY_API_KEY=

# ---- Passcode auth (replaces Supabase Auth / accounts) ----
# JARVIS is single-user now: there's no signup/login, just one shared codeword
# that unlocks the whole app. CHANGE THIS from the default before using this
# anywhere but your own machine — anyone who knows this word gets full access,
# including the terminal if ENABLE_TERMINAL=true.
JARVIS_PASSCODE=Namo

# Auto-generated on first run and cached in data/.jwt-secret if left blank —
# only set this yourself if you want a fixed value (e.g. shared across a
# reinstall) or are running multiple instances that should share sessions.
JWT_SECRET=

# ---- Supabase: optional (chat history / memory storage only) ----
# Supabase is no longer used for auth — only to persist chat history and
# memory across restarts. Leave blank and JARVIS still runs fine; it just
# won't remember past sessions.
#   1. Create a free project at supabase.com
#   2. Run supabase-schema.sql (in this folder) in its SQL editor
#   3. Copy the two values below from Settings > API
# The service_role key is server-only — it bypasses row security by design, so it
# must never appear in frontend code or be committed anywhere.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Real vector memory: optional, requires Supabase above ----
# Off by default — long-term memory (utils/longTermMemory.js) uses a local
# JSON file with a brute-force in-process cosine scan, which is plenty fast
# up to the low thousands of entries. Set this to true once you've:
#   1. Configured SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above
#   2. Run supabase-schema-vector.sql (in this folder) in the SQL editor
#      (check the dimension note at the top of that file first — it
#      defaults to Gemini's 768-dim embeddings)
# to switch to real pgvector cosine search in Postgres instead. If this is
# true but Supabase isn't configured, JARVIS logs a warning and falls back
# to the JSON backend rather than failing to start.
USE_PGVECTOR_MEMORY=false

# Server config
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend dev URL)
CORS_ORIGIN=http://localhost:5173
# Set to "true" only if this runs behind a reverse proxy/load balancer (nginx,
# Cloudflare, etc.) — makes rate limiting key on the real client IP from
# X-Forwarded-For instead of the proxy's. Leave false for direct/local use;
# trusting that header with nothing actually in front of it lets a client
# spoof its own IP and dodge rate limits.
TRUST_PROXY=false

# Terminal endpoint safety
# Set to "true" only if you understand the risk — see README "Terminal security" section.
# Defaults to false: the terminal panel in the UI is now wired to run real commands on
# your machine, so this should stay off until you deliberately want that.
ENABLE_TERMINAL=false

# Multi-agent routing
# JARVIS classifies every message and routes it to a specialist agent
# (general / researcher / coder / reasoner), each with its own system prompt and
# its own preferred provider order. Nothing to configure — but the more provider
# keys you fill in above, the better each specialist can be matched to a model.

# Smart file search — restricts search/open to these directories only.
# Semicolon-separated on Windows, colon-separated on macOS/Linux.
# Defaults to your Desktop, Documents, and Downloads folders if left unset.
# FILE_SEARCH_ROOTS=C:\Users\you\Documents;C:\Users\you\Desktop

# Mouse & keyboard automation — OFF by default. Both this and browser
# automation can also be toggled at runtime without a restart via
# POST /api/input/enable and /api/browser/enable ({"enabled": true|false}).
ENABLE_INPUT_AUTOMATION=false

# Browser automation (Playwright driving your installed Chrome/Edge) — OFF by default.
ENABLE_BROWSER_AUTOMATION=false
# Set true to run the automated browser without a visible window.
BROWSER_HEADLESS=false

# Plugin/extension system — OFF by default. A plugin is a folder under
# plugins/ with a plugin.json manifest + an index.js exporting execute(args, ctx);
# see utils/pluginLoader.js for the full contract. Plugin code runs in-process
# with the same privileges as the rest of the server (not sandboxed) — review
# a plugin before enabling this, same as you would before running any other
# local script.
ENABLE_PLUGINS=false
# A plugin can additionally mark a tool "permission":"dangerous" in its
# manifest — that specific tool stays blocked until this is ALSO true, even
# with ENABLE_PLUGINS=true.
ENABLE_PLUGIN_DANGEROUS_ACTIONS=false

# Image generation for the Imagination panel's "generate an image" mode
# (separate from its key-free 3D scene-graph mode). Uses whichever of
# OPENAI_API_KEY / GEMINI_API_KEY above is already set — nothing new to add
# if you've already configured either for chat/vision. Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Proactive Insights agent — OFF by default. When on, a background timer
# periodically hands the LLM a small snapshot (upcoming calendar items, the
# active window, a few learned preferences) and asks it to decide whether
# there's ONE genuinely useful thing worth proactively surfacing right now
# (e.g. "meeting in 10 minutes"). Unlike calendar reminders (free — no LLM
# call), this makes a real LLM call every tick whether or not you're looking
# at the app, so it costs API usage and needs an explicit opt-in.
ENABLE_PROACTIVE_AGENT=false
# How often it checks, in minutes. Floor of 5 — a lower value here is
# silently raised to 5 rather than hammering the LLM on a typo.
PROACTIVE_AGENT_INTERVAL_MINUTES=15
